# JobMatch — Environment Variable Template
# Bu dosya git'e commit EDİLİR. Local geliştirme için bu dosyayı .env olarak kopyalayıp
# kendi değerlerinizle doldurun: cp .env.example .env
# Aşağıdaki değerler örnektir, gerçek/local değerler için .env dosyasına bakın.

# ==== Application ====
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=<server_port>

# ==== PostgreSQL — local: Docker Compose (bkz. ADR-009) ====
POSTGRES_DB=<db_name>
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_HOST=<db_host>
POSTGRES_PORT=<db_port>
SPRING_DATASOURCE_URL=jdbc:postgresql://<db_host>:<db_port>/<db_name>
SPRING_DATASOURCE_USERNAME=<db_user>
SPRING_DATASOURCE_PASSWORD=<db_password>

# ==== Neon — yalnızca staging/production (bkz. ADR-009) ====
# Local development'ta KULLANILMAZ; staging/production deploy secret'ları burada tutulmaz.
# NEON_DATABASE_URL_POOLED=postgres://<neon_user>:<neon_password>@<endpoint>-pooler.<region>.aws.neon.tech/<db_name>?sslmode=require
# NEON_DATABASE_URL_DIRECT=postgres://<neon_user>:<neon_password>@<endpoint>.<region>.aws.neon.tech/<db_name>?sslmode=require

# ==== Keycloak (bkz. ADR-008, docs/IDENTITY.md) ====
# KEYCLOAK_ADMIN_USERNAME/PASSWORD yalnizca local Docker Compose container'inin admin
# bootstrap kimlik bilgileridir (KC_BOOTSTRAP_ADMIN_USERNAME/PASSWORD olarak container'a
# gecirilir) - production/staging Keycloak'ta kullanilmaz.
KEYCLOAK_ADMIN_USERNAME=<keycloak_admin_username>
KEYCLOAK_ADMIN_PASSWORD=<keycloak_admin_password>
KEYCLOAK_PORT=<keycloak_port>
KEYCLOAK_AUTH_SERVER_URL=<keycloak_base_url>
KEYCLOAK_REALM=<realm_name>
KEYCLOAK_ISSUER_URI=<keycloak_base_url>/realms/<realm_name>
KEYCLOAK_CLIENT_ID=<client_id>

# ==== Mailpit (SMTP test server, bkz. docs/IDENTITY.md madde 7) ====
# Keycloak'in email dogrulama/sifre sifirlama akislari icin kullandigi dev SMTP sunucusu.
# SMTP portu (1025) yalnizca Docker Compose network'u icinde Keycloak tarafindan kullanilir,
# host'a expose edilmez. Web UI'da gonderilen e-postalar goruntulenir.
MAILPIT_UI_PORT=<mailpit_ui_port>

# ==== Elasticsearch (bkz. docs/ELASTICSEARCH.md) ====
ELASTICSEARCH_SCHEME=<http_or_https>
ELASTICSEARCH_HOST=<elasticsearch_host>
ELASTICSEARCH_PORT=<elasticsearch_port>

# ==== Kafka (bkz. docs/EVENTS.md) ====
KAFKA_BOOTSTRAP_SERVERS=<kafka_host>:<kafka_port>

# ==== Redis (bkz. docs/SECURITY.md — rate limiting/cache) ====
REDIS_HOST=<redis_host>
REDIS_PORT=<redis_port>
REDIS_PASSWORD=<redis_password_optional>
